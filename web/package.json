{
  "name": "cloudflare-mobile-task-executor",
  "version": "1.0.0",
  "description": "Mobile web platform for executing tasks via Cloudflare and GitHub Actions",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "lint": "eslint src/ auth/ tests/",
    "lint:fix": "eslint src/ auth/ tests/ --fix",
    "format": "prettier --write src/ auth/ tests/",
    "build": "webpack --mode production",
    "docker:build": "docker build -t cloudflare-task-executor .",
    "docker:run": "docker run -p 3000:3000 cloudflare-task-executor",
    "migrate": "node database/migrate.sh",
    "migrate:test": "NODE_ENV=test node database/migrate.sh"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^6.1.5",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.10.0",
    "octokit": "^5.0.5",
    "socket.io": "^4.6.1",
    "winston": "^3.8.2",
    "multer": "^2.1.0",
    "cloudflared": "^0.1.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "nodemon": "^2.0.22",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.0.1",
    "eslint": "^8.38.0",
    "prettier": "^2.8.7",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0"
  },
  "keywords": [
    "cloudflare",
    "github",
    "mobile",
    "task-execution",
    "ansible",
    "devops",
    "automation",
    "security"
  ],
  "author": "Qwen Code",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cbwinslow/ansible-task-queue.git"
  },
  "bugs": {
    "url": "https://github.com/cbwinslow/ansible-task-queue/issues"
  },
  "homepage": "https://github.com/cbwinslow/ansible-task-queue#readme"
}